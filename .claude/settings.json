{
  "permissions": {
    "allow": [
      "Bash(npm run dev*)",
      "Bash(npm run build*)",
      "Bash(npm run preview*)",
      "Bash(npm run check*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run verify*)",
      "Bash(npm run e2e*)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./scripts/data/.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
